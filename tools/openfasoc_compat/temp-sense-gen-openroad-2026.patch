--- /dev/null
+++ b/flow/scripts/mark_vin.tcl
@@ -0,0 +1,4 @@
+# the analog domain supply VIN is a power net: mark it so the installed OpenROAD's global router does not try to route it as a signal (GRT-0042)
+foreach net [[ord::get_db_block] getNets] {
+  if {[$net getName] eq "VIN"} { $net setSigType POWER }
+}
